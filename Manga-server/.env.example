# 复制为 .env 后填写强密码，应用和 MySQL Compose 共用此配置。
MANGA_DB_PASSWORD=
MANGA_DB_HOST=localhost
MANGA_DB_PORT=3306
MANGA_DB_NAME=Manga
MANGA_DB_USERNAME=root

# Redis 连接配置；服务器启用认证时必须填写密码。
MANGA_REDIS_HOST=localhost
MANGA_REDIS_PORT=6379
MANGA_REDIS_PASSWORD=
MANGA_REDIS_DATABASE=0

# 首次建库需要填写；JWT 密钥至少 32 字节，管理员密码不会写入 SQL 或仓库。
MANGA_JWT_SECRET=
# AI API Key 落库前的加密密钥；生产环境请使用与 JWT 不同的高强度随机值。
MANGA_AI_SECRET_ENCRYPTION_KEY=
MANGA_INITIAL_ADMIN_USERNAME=admin
MANGA_INITIAL_ADMIN_PASSWORD=

# 微信公众号扫码登录；Token 需与公众号后台消息推送配置保持一致。
MANGA_WECHAT_GZH_APP_ID=
MANGA_WECHAT_GZH_SECRET=
MANGA_WECHAT_GZH_TOKEN=

# 阿里云 OSS；填写 Endpoint 和 RAM 用户 AccessKey 后，将 enabled 改为 true。
MANGA_OSS_ENABLED=true
MANGA_OSS_ENDPOINT=
MANGA_OSS_ACCESS_KEY_ID=
MANGA_OSS_ACCESS_KEY_SECRET=
MANGA_OSS_BUCKET_NAME=manga-ai
MANGA_OSS_OBJECT_PREFIX=mannga
# 可选：已绑定到 Bucket 的 CDN 或自定义公开域名。
MANGA_OSS_PUBLIC_DOMAIN=

# 可按部署环境覆盖 MySQL 镜像和容器名称。
MANGA_MYSQL_IMAGE=mysql:8.4
MANGA_MYSQL_CONTAINER_NAME=mysql-server
