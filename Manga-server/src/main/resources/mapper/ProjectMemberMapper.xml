<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.manga.mapper.ProjectMemberMapper">

    <resultMap id="projectMemberResultMap" type="com.manga.entity.ProjectMember">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="userId" column="user_id"/>
        <result property="role" column="role" javaType="com.manga.common.enums.ProjectMemberRole"/>
        <result property="username" column="username"/>
        <result property="displayName" column="display_name"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>

    <select id="findMembersByProject" resultMap="projectMemberResultMap">
        SELECT pm.id,
               pm.project_id,
               pm.user_id,
               pm.role,
               u.username,
               u.display_name,
               pm.created_at,
               pm.updated_at,
               pm.created_by,
               pm.updated_by
        FROM manga_project_member pm
        INNER JOIN manga_user u ON u.id = pm.user_id
        WHERE pm.project_id = #{projectId}
        ORDER BY CASE pm.role
                 WHEN 'OWNER' THEN 1
                 WHEN 'ADMIN' THEN 2
                 ELSE 3
                 END,
                 pm.id
    </select>

    <select id="findMember" resultMap="projectMemberResultMap">
        SELECT pm.id,
               pm.project_id,
               pm.user_id,
               pm.role,
               u.username,
               u.display_name,
               pm.created_at,
               pm.updated_at,
               pm.created_by,
               pm.updated_by
        FROM manga_project_member pm
        INNER JOIN manga_user u ON u.id = pm.user_id
        WHERE pm.project_id = #{projectId}
          AND pm.user_id = #{userId}
    </select>
</mapper>
