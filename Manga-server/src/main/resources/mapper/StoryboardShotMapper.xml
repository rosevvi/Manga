<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.manga.mapper.StoryboardShotMapper">

    <resultMap id="storyboardShotResultMap" type="com.manga.entity.StoryboardShot">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="shotNumber" column="shot_number"/>
        <result property="title" column="title"/>
        <result property="sceneName" column="scene_name"/>
        <result property="shotType" column="shot_type"/>
        <result property="cameraMovement" column="camera_movement"/>
        <result property="durationSeconds" column="duration_seconds"/>
        <result property="content" column="content"/>
        <result property="dialogue" column="dialogue"/>
        <result property="soundEffect" column="sound_effect"/>
        <result property="imageUrl" column="image_url"/>
        <result property="notes" column="notes"/>
        <result property="status" column="status" javaType="com.manga.common.enums.StoryboardShotStatus"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>

    <select id="findAllByProjectId" resultMap="storyboardShotResultMap">
        SELECT *
        FROM manga_storyboard_shot
        WHERE project_id = #{projectId}
        ORDER BY sort_order, id
    </select>

    <select id="findByProjectAndId" resultMap="storyboardShotResultMap">
        SELECT *
        FROM manga_storyboard_shot
        WHERE project_id = #{projectId}
          AND id = #{shotId}
    </select>

    <select id="findNextSortOrder" resultType="int">
        SELECT COALESCE(MAX(sort_order), 0) + 1
        FROM manga_storyboard_shot
        WHERE project_id = #{projectId}
    </select>

    <update id="updateInProject">
        UPDATE manga_storyboard_shot
        SET title = #{shot.title},
            scene_name = #{shot.sceneName},
            shot_type = #{shot.shotType},
            camera_movement = #{shot.cameraMovement},
            duration_seconds = #{shot.durationSeconds},
            content = #{shot.content},
            dialogue = #{shot.dialogue},
            sound_effect = #{shot.soundEffect},
            image_url = #{shot.imageUrl},
            notes = #{shot.notes},
            status = #{shot.status},
            updated_by = #{shot.updatedBy}
        WHERE id = #{shot.id}
          AND project_id = #{projectId}
    </update>

    <update id="updateOrder">
        UPDATE manga_storyboard_shot
        SET sort_order = CASE id
            <foreach collection="shotIds" item="shotId" index="index">
                WHEN #{shotId} THEN #{index} + 1
            </foreach>
            END,
            shot_number = CASE id
            <foreach collection="shotIds" item="shotId" index="index">
                WHEN #{shotId} THEN CONCAT('SHOT-', LPAD(#{index} + 1, 3, '0'))
            </foreach>
            END,
            updated_by = #{actor}
        WHERE project_id = #{projectId}
          AND id IN
        <foreach collection="shotIds" item="shotId" open="(" separator="," close=")">
            #{shotId}
        </foreach>
    </update>
</mapper>
