<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.manga.mapper.ProjectWorkflowMapper">

    <resultMap id="workflowResultMap" type="com.manga.entity.ProjectWorkflow">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="currentStage" column="current_stage" javaType="com.manga.common.enums.ProjectWorkflowStage"/>
        <result property="stageRevision" column="stage_revision"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>

    <select id="findByProjectId" resultMap="workflowResultMap">
        SELECT id, project_id, current_stage, stage_revision, created_at, updated_at, created_by, updated_by
        FROM manga_project_workflow
        WHERE project_id = #{projectId}
    </select>

    <update id="updateStage">
        UPDATE manga_project_workflow
        SET current_stage = #{workflow.currentStage},
            stage_revision = stage_revision + 1,
            updated_at = CURRENT_TIMESTAMP,
            updated_by = #{workflow.updatedBy}
        WHERE project_id = #{workflow.projectId}
    </update>
</mapper>
