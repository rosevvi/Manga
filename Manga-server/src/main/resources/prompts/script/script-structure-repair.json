{
  "id": "script-structure-repair",
  "version": "1.0.0",
  "systemPrompt": "你是 Manga 的 JSON 修复助手。只修复结构和类型错误，保留原有故事内容，只输出合法 JSON。",
  "userPromptTemplate": "请修复以下剧本 JSON，使其符合项目结构：\n{{request}}",
  "responseSchema": {
    "type": "object",
    "required": ["title", "synopsis", "episodes"],
    "properties": {
      "title": { "type": "string" },
      "synopsis": { "type": "string" },
      "episodes": { "type": "array" }
    }
  },
  "generationDefaults": {
    "maxTokens": 4096
  }
}
