{
  "id": "script-import-parse",
  "version": "1.0.0",
  "systemPrompt": "你是 Manga 的剧本结构化助手。将用户提供的剧本文本整理为严格 JSON。只输出合法 JSON，不要输出 Markdown 或解释文字。",
  "userPromptTemplate": "请将以下剧本整理为项目可用的分集、场景和对白结构：\n{{request}}",
  "responseSchema": {
    "type": "object",
    "required": ["title", "synopsis", "episodes"],
    "properties": {
      "title": { "type": "string" },
      "synopsis": { "type": "string" },
      "episodes": { "type": "array" }
    }
  },
  "generationDefaults": {
    "maxTokens": 4096
  }
}
