# 前端请求的后端 API 根地址，部署时填写实际后端地址。
VITE_API_BASE_URL=http://localhost:8080/api/v1
# 开发时可在 .env.development.local 将上面的地址设为 /api/v1，以启用同源代理。
# 仅用于 Vite 开发服务，填写后端站点地址，不包含 /api/v1。
VITE_API_PROXY_TARGET=http://localhost:8080
# 可选开发网络代理，仅 HTTPS 远端转发使用；不填写时直接连接后端。
DEV_API_PROXY_URL=
# 认证请求超时时间，毫秒；覆盖二维码创建及状态轮询。
VITE_AUTH_REQUEST_TIMEOUT_MS=20000
